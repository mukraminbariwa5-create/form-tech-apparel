{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "form-tech/apparel",
  "type": "project",
  "description": "FORM/TECH portfolio apparel commerce demo",
  "license": "MIT",
  "require": {"php": "^8.4", "inertiajs/inertia-laravel": "^3.0", "laravel/fortify": "^1.37.2", "laravel/framework": "^13.17"},
  "require-dev": {"fakerphp/faker": "^1.24", "laravel/pint": "^1.27", "laravel/sail": "^1.53", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.9.3", "phpunit/phpunit": "^12.5.23"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "test": ["@php artisan config:clear", "@php artisan test"],
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-update-cmd": ["@php artisan vendor:publish --tag=laravel-assets --ansi --force"]
  },
  "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
  "minimum-stability": "stable", "prefer-stable": true
}
