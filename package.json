{
  "name": "form-tech-apparel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:ssr": "vite build && vite build --ssr",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=/opt/form-tech-browser playwright test",
    "test:responsive": "PLAYWRIGHT_BROWSERS_PATH=/opt/form-tech-browser playwright test --config=playwright.responsive.config.ts",
    "images:optimize": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@inertiajs/react": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.3",
    "laravel-vite-plugin": "^3.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
